# ---- Python 编译缓存 ----
__pycache__/
*.py[cod]
*$py.class

# ---- 虚拟环境与打包产物 ----
.venv/
venv/
ENV/
env/
build/
dist/
*.egg-info/
*.egg
*.spec

# ---- 编辑器与系统文件 ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ---- 运行日志与临时文件 ----
logs/
*.log
*.tmp
*.bak
*.swp

# ---- 程序运行时生成的文件（模板本身不在此列） ----
# runtime/pdf/ 下生成的报告 PDF 不入仓，模板 abc.xlsx 正常入仓。
runtime/pdf/*.pdf
# SQLite 运行时产生的临时文件不入仓，数据库本身 bogie.db 正常入仓。
*.db-journal
*.db-wal
*.db-shm

# ---- 测试与检查缓存 ----
.mypy_cache/
.pytest_cache/