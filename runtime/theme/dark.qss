QWidget {
    background: #09131c;
    color: #dbe9f4;
    font: 10pt "Microsoft YaHei";
}

QMainWindow, QDialog {
    background: #09131c;
}

QToolBar#mainToolbar {
    spacing: 2px;
    padding: 4px 6px;
    background: #0d1823;
    border: none;
    border-bottom: 1px solid #16364b;
}

QToolButton {
    background: transparent;
    color: #d8ebf8;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 3px 8px;
}

QToolButton:hover, QToolButton:pressed {
    background: rgba(58, 133, 181, 0.16);
    border: 1px solid #2f617d;
}

QWidget#frameLogoCard, QWidget#mainFooter {
    background: #0d1823;
    border: none;
    border-bottom: 1px solid #16364b;
}

QLabel#frameLogoImage {
    padding: 1px 0 0 0;
}

QToolButton#currentUserButton {
    background: #102332;
    border: 1px solid #22465c;
    border-radius: 8px;
    color: #d8ebf8;
    font-weight: 600;
    padding: 3px 8px;
}

QToolButton#currentUserButton:hover {
    background: #153043;
    border: 1px solid #2f617d;
}

QToolButton#footerActionButton {
    background: #102332;
    border: 1px solid #22465c;
    border-radius: 8px;
    color: #d8ebf8;
    font-weight: 600;
    padding: 3px 8px;
}

QToolButton#footerActionButton:hover {
    background: #153043;
    border: 1px solid #2f617d;
}

QLabel#statusStateLabel {
    color: #ffffff;
    font-weight: 700;
    border-radius: 8px;
    padding: 3px 10px;
}

QTabWidget::pane {
    border: none;
}

QTabBar::tab {
    background: #0d1c28;
    color: #8fb8d3;
    padding: 5px 10px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background: #122a3a;
    color: #ffffff;
}

QFrame#flowControlPanel, QFrame#monitorCard, QFrame#tableCard, QFrame#homeStatusBar, QFrame#anchorInfoCard, QFrame#dynamicRectCenterCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0d1a25, stop:1 #122636);
    border: 1px solid #1b3e54;
    border-radius: 12px;
}

QDialog#plcDialog QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0d1a25, stop:1 #122636);
    border: 1px solid #1b3e54;
    border-radius: 12px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: 600;
}

QDialog#plcDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #eff8ff;
}

QLabel#homeHeroTitle {
    font-size: 20px;
    font-weight: 700;
    color: #eff8ff;
}

QLabel#homeHeroDesc, QLabel#flowHint, QLabel#workflowState, QLabel#subtleTitle {
    color: #8db2c9;
}

QLabel#cardTitle {
    font-size: 15px;
    font-weight: 700;
    color: #eff8ff;
}

QLabel#flowCurrentLabel {
    color: #90e7ff;
    font-weight: 600;
}

QLabel#anchorMetricLabel {
    color: #9bb8ca;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0d7ca6, stop:1 #17a9d2);
    color: #041118;
    font-weight: 700;
    border: 1px solid #55c4ec;
    border-radius: 8px;
    padding: 4px 8px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #13a4d4, stop:1 #64dbff);
}

QPushButton:pressed {
    background: #0b90ba;
}

QPushButton:disabled {
    background: #31424d;
    color: #698396;
    border-color: #3c5360;
}

QLineEdit#anchorMoveEdit {
    background: rgba(6, 16, 23, 0.78);
    border: 1px solid #1b4359;
    border-radius: 8px;
    padding: 3px 6px;
    color: #dbe9f4;
}

QLineEdit#flowMetaEdit {
    background: rgba(6, 16, 23, 0.78);
    border: 1px solid #1b4359;
    border-radius: 8px;
    padding: 3px 6px;
    color: #dbe9f4;
}

QListWidget, QTableWidget, QPlainTextEdit {
    background: rgba(6, 16, 23, 0.78);
    alternate-background-color: rgba(19, 37, 51, 0.95);
    border: 1px solid #1b4359;
    border-radius: 8px;
    padding: 3px;
    color: #dbe9f4;
    gridline-color: #17364a;
    selection-background-color: rgba(45, 163, 212, 0.28);
    selection-color: #ffffff;
}

QDialog#plcDialog QTextEdit,
QDialog#plcDialog QLineEdit,
QDialog#plcDialog QComboBox {
    background: rgba(6, 16, 23, 0.78);
    border: 1px solid #1b4359;
    border-radius: 8px;
    padding: 3px 6px;
    color: #dbe9f4;
}

QHeaderView::section {
    background: #0f2130;
    color: #8fd8ef;
    padding: 4px;
    border: none;
    border-bottom: 1px solid #1f4358;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #29556c;
    border-radius: 5px;
}

QLabel#statusStateLabel[online="true"] {
    background: #16c16f;
    border: 1px solid #97ffd0;
}

QLabel#statusStateLabel[online="false"] {
    background: #f0445c;
    border: 1px solid #ff97a4;
}

QLabel#faultText {
    color: #ffd0d6;
    font-weight: 600;
}